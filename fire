-- Variables
local detectedItemId = nil
local detectedItemType = nil

-- Function: Detect item dari mouse target
local function detectItemAtMouse()
    local target = mouse.Target
    
    if not target then
        statusLabel.Text = "Status: Gak ada object di mouse"
        return nil
    end
    
    -- Cari model parent kalau yang di-click adalah part
    local model = target:FindFirstAncestorWhichIsA("Model") or target
    local itemId = nil
    local itemType = "Unknown"
    
    -- Method 1: Cari Attribute
    itemId = model:GetAttribute("ItemId") or 
             model:GetAttribute("ProductId") or 
             model:GetAttribute("AssetId") or
             model:GetAttribute("ID")
    
    if itemId then
        itemType = "Attribute"
    end
    
    -- Method 2: Cari IntValue/NumberValue di dalam model
    if not itemId then
        for _, value in pairs(model:GetDescendants()) do
            if value:IsA("IntValue") or value:IsA("NumberValue") then
                local name = value.Name:lower()
                if string.find(name, "id") or string.find(name, "product") or 
                   string.find(name, "asset") or string.find(name, "item") then
                    itemId = value.Value
                    itemType = value.Name
                    break
                end
            end
        end
    end
    
    -- Method 3: Parse dari nama model (kalau developer taro ID di nama)
    if not itemId then
        local modelName = model.Name
        local idMatch = string.match(modelName, "%d+")
        if idMatch then
            itemId = tonumber(idMatch)
            itemType = "Parsed from Name"
        end
    end
    
    -- Method 4: Cari Script yang punya ProductId di dalamnya
    if not itemId then
        for _, script in pairs(model:GetDescendants()) do
            if script:IsA("LocalScript") or script:IsA("Script") then
                local success, source = pcall(function()
                    return script:GetFullName() -- Fallback kalau source di-protected
                end)
                -- Kalau bisa baca source, coba parse ProductId
                if success and source then
                    local productId = string.match(source, "ProductId%s*=%s*(%d+)")
                    if productId then
                        itemId = tonumber(productId)
                        itemType = "From Script"
                        break
                    end
                end
            end
        end
    end
    
    if itemId then
        detectedItemId = itemId
        detectedItemType = itemType
        idDisplay.Text = "Item ID: " .. tostring(itemId) .. "\nSource: " .. itemType
        idDisplay.TextColor3 = Color3.fromRGB(100, 255, 100)
        statusLabel.Text = "Status: Item terdeteksi!"
        return itemId
    else
        idDisplay.Text = "Item ID: [TIDAK DITEMUKAN]"
        idDisplay.TextColor3 = Color3.fromRGB(255, 80, 80)
        statusLabel.Text = "Status: ID tidak ditemukan di object ini"
        return nil
    end
end

-- Function: Eksekusi bypass
local function executeBypass(itemId)
    if not itemId then
        statusLabel.Text = "Status: ERROR - Belum ada ID terdeteksi"
        return
    end
    
    statusLabel.Text = "Status: Firing payloads..."
    
    -- Payload 1: Spoof PromptProductPurchaseFinished
    pcall(function()
        MarketplaceService:PromptProductPurchaseFinished(
            player.UserId, 
            tonumber(itemId), 
            Enum.ProductPurchaseDecision.PurchaseGranted
        )
    end)
    
    -- Payload 2: Fire semua RemoteEvent yang namanya mirip shop/buy/purchase
    local remoteCount = 0
    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") then
            local name = remote.Name:lower()
            if string.find(name, "buy") or string.find(name, "shop") or 
               string.find(name, "purchase") or string.find(name, "item") or
               string.find(name, "product") or string.find(name, "get") or
               string.find(name, "claim") or string.find(name, "give") then
                
                -- Spam berbagai variasi argument
                pcall(function() remote:FireServer(tonumber(itemId)) end)
                pcall(function() remote:FireServer(tostring(itemId)) end)
                pcall(function() remote:FireServer(tonumber(itemId), true) end)
                pcall(function() remote:FireServer(tonumber(itemId), player.UserId) end)
                pcall(function() remote:FireServer(tonumber(itemId), 1) end)
                pcall(function() remote:FireServer(tonumber(itemId), "PurchaseGranted") end)
                
                remoteCount = remoteCount + 1
            end
        end
    end
    
    -- Payload 3: Fire RemoteFunction (kalau ada)
    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteFunction") then
            local name = remote.Name:lower()
            if string.find(name, "buy") or string.find(name, "shop") or 
               string.find(name, "purchase") or string.find(name, "item") then
                
                pcall(function() remote:InvokeServer(tonumber(itemId)) end)
                pcall(function() remote:InvokeServer(tonumber(itemId), true) end)
                remoteCount = remoteCount + 1
            end
        end
    end
    
    statusLabel.Text = "Status: DONE - Fired " .. remoteCount .. " remotes. Cek inventory!"
    
    -- Auto-refresh display setelah 3 detik
    task.delay(3, function()
        statusLabel.Text = "Status: Arahkan mouse ke item shop"
    end)
end

